  RewriteRule ^(?:(?:uz|ru|en)/)?teachersshavkatfozilov/?$ https://airi.uz/umumiy-malumot/institute-teachers/fozilov-shavkat/ [R=301,L]
  RewriteRule ^(?:(?:uz|ru|en)/)?teachersmirzayevnomoz/?$ https://airi.uz/umumiy-malumot/institute-teachers/mirzayev-nomaz/ [R=301,L]
