# old.airi.uz / old2.airi.uz — eski domenlar uchun .htaccess
#
# AVTOMATIK GENERATSIYA QILINGAN: scripts/generate-legacy-redirects.mjs
# Qo'lda tahrirlamang — moslikni `web-airi/public/.htaccess` dagi
# `legacy-map` bloki ichida o'zgartiring va qayta build qiling.
#
# Ishlatish: shu faylni eski domen(lar)ning public_html papkasiga `.htaccess`
# nomi bilan yuklang. O'sha papkada boshqa hech narsa kerak emas.
#
# MUHIM: bu domenda 410 (`[G]`) ISHLATMANG va `robots.txt` bilan
# indeksatsiyani TAQIQLAMANG. Googlebot 301'ni o'qiy olishi shart — aks holda
# u eski manzillarni indeksdan olib tashlamaydi va eski sahifalarning reyting
# vazni yangi saytga o'tmaydi.

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # HTTPS majburiy — 301 zanjiri qisqa bo'lsin
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

  # Eski manzil -> yangi saytdagi MOS sahifa (bitta sakrashda)
  RewriteRule ^ru/(?:institute|about|ob-institute)/?$ https://airi.uz/ru/umumiy-malumot/institute-abouttheinstitute/ [R=301,L]
  RewriteRule ^ru/(?:structure|struktura)/?$ https://airi.uz/ru/umumiy-malumot/institute-structureofinstitute/ [R=301,L]
  RewriteRule ^ru/(?:team|staff|rukovodstvo)/?$ https://airi.uz/ru/umumiy-malumot/institute-instituteteam/ [R=301,L]
  RewriteRule ^ru/(?:teachers|professors)/?$ https://airi.uz/ru/umumiy-malumot/institute-teachers/ [R=301,L]
  RewriteRule ^ru/(?:history|istoriya)/?$ https://airi.uz/ru/umumiy-malumot/history/ [R=301,L]
  RewriteRule ^ru/(?:partners|partnery)(?:/.*)?$ https://airi.uz/ru/umumiy-malumot/partners/ [R=301,L]
  RewriteRule ^ru/(?:vacanc(?:y|ies)|vakansii)/?$ https://airi.uz/ru/umumiy-malumot/opendata-vacancies/ [R=301,L]
  RewriteRule ^ru/faq/?$ https://airi.uz/ru/umumiy-malumot/faq/ [R=301,L]
  RewriteRule ^ru/news(?:/.*)?$ https://airi.uz/ru/umumiy-malumot/news/ [R=301,L]
  RewriteRule ^ru/(?:science|research|nauka)/?$ https://airi.uz/ru/ilmiy-tadqiqot/ [R=301,L]
  RewriteRule ^ru/(?:laborator(?:y|ies)|labs|laboratorii)(?:/.*)?$ https://airi.uz/ru/ilmiy-tadqiqot/research-laboratories/ [R=301,L]
  RewriteRule ^ru/(?:conferences?|konferentsii)/?$ https://airi.uz/ru/ilmiy-tadqiqot/research-conferences/ [R=301,L]
  RewriteRule ^ru/(?:doctorate|aspirantura|phd)/?$ https://airi.uz/ru/ilmiy-tadqiqot/research-doctorate/ [R=301,L]
  RewriteRule ^ru/(?:scientific-?council|council|sovet)/?$ https://airi.uz/ru/ilmiy-tadqiqot/research-scientificboard/ [R=301,L]
  RewriteRule ^ru/(?:contacts?|kontakty|kontakt)/?$ https://airi.uz/ru/boglanish/ [R=301,L]
  RewriteRule ^en/(?:institute|about)/?$ https://airi.uz/en/umumiy-malumot/institute-abouttheinstitute/ [R=301,L]
  RewriteRule ^en/structure/?$ https://airi.uz/en/umumiy-malumot/institute-structureofinstitute/ [R=301,L]
  RewriteRule ^en/(?:team|staff|management)/?$ https://airi.uz/en/umumiy-malumot/institute-instituteteam/ [R=301,L]
  RewriteRule ^en/(?:teachers|professors|faculty)/?$ https://airi.uz/en/umumiy-malumot/institute-teachers/ [R=301,L]
  RewriteRule ^en/history/?$ https://airi.uz/en/umumiy-malumot/history/ [R=301,L]
  RewriteRule ^en/partners(?:/.*)?$ https://airi.uz/en/umumiy-malumot/partners/ [R=301,L]
  RewriteRule ^en/(?:vacanc(?:y|ies)|jobs|careers)/?$ https://airi.uz/en/umumiy-malumot/opendata-vacancies/ [R=301,L]
  RewriteRule ^en/faq/?$ https://airi.uz/en/umumiy-malumot/faq/ [R=301,L]
  RewriteRule ^en/news(?:/.*)?$ https://airi.uz/en/umumiy-malumot/news/ [R=301,L]
  RewriteRule ^en/(?:science|research)/?$ https://airi.uz/en/ilmiy-tadqiqot/ [R=301,L]
  RewriteRule ^en/(?:laborator(?:y|ies)|labs)(?:/.*)?$ https://airi.uz/en/ilmiy-tadqiqot/research-laboratories/ [R=301,L]
  RewriteRule ^en/conferences?/?$ https://airi.uz/en/ilmiy-tadqiqot/research-conferences/ [R=301,L]
  RewriteRule ^en/(?:doctorate|phd|doctoral-?studies)/?$ https://airi.uz/en/ilmiy-tadqiqot/research-doctorate/ [R=301,L]
  RewriteRule ^en/(?:scientific-?council|council)/?$ https://airi.uz/en/ilmiy-tadqiqot/research-scientificboard/ [R=301,L]
  RewriteRule ^en/contacts?/?$ https://airi.uz/en/boglanish/ [R=301,L]
  RewriteRule ^(?:(?:uz|ru|en)/)?institute-degreeawardingscientificcouncil/?$ https://airi.uz/ilmiy-tadqiqot/degree-awarding-council/ [R=301,L]
  RewriteRule ^(?:(?:uz|ru|en)/)?research-internationalrelationships/?$ https://airi.uz/umumiy-malumot/research-internationalrelationships/ [R=301,L]
  RewriteRule ^(?:(?:uz|ru|en)/)?generalinformation-trainingcourse/?$ https://airi.uz/ilmiy-tadqiqot/research-doctorate/ [R=301,L]
  RewriteRule ^(?:(?:uz|ru|en)/)?(institute-(?:abouttheinstitute|eventcalendar|graduates|instituteteam|internaldocuments|structureofinstitute|talentedyouth|teachers))/?$ https://airi.uz/umumiy-malumot/$1/ [R=301,L]
  RewriteRule ^(?:(?:uz|ru|en)/)?(opendata-(?:managementreceptiondays|requisitesoftheinstitute|vacancies))/?$ https://airi.uz/umumiy-malumot/$1/ [R=301,L]
  RewriteRule ^(?:(?:uz|ru|en)/)?(generalinformation-statesymbols)/?$ https://airi.uz/umumiy-malumot/$1/ [R=301,L]
  RewriteRule ^(?:(?:uz|ru|en)/)?(research-(?:conferences|doctorate|laboratories|scientificboard))/?$ https://airi.uz/ilmiy-tadqiqot/$1/ [R=301,L]
