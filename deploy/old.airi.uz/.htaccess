  RewriteRule ^(?:(?:uz|ru|en)/)?(?:rekvizit|guvohnoma)/?$ https://airi.uz/umumiy-malumot/opendata-requisitesoftheinstitute/ [R=301,L]
  RewriteRule ^(?:(?:uz|ru|en)/)?(?:maqola2|maqola3|tadqiqotmaqolasi)/?$ https://airi.uz/ilmiy-tadqiqot/ [R=301,L]
  RewriteRule ^(?:(?:uz|ru|en)/)?digitaltechnologiesandartificialintelligencetodayandthefuture/?$ https://airi.uz/ilmiy-tadqiqot/research-conferences/ [R=301,L]
  RewriteRule ^(?:(?:uz|ru|en)/)?05\.?01\.?(?:02|07|11|03)/?$ https://airi.uz/ilmiy-tadqiqot/research-doctorate/ [R=301,L]
  RewriteRule ^(?:(?:uz|ru|en)/)?pdf-viewer(?:/.*)?$ https://airi.uz/umumiy-malumot/institute-internaldocuments/ [R=301,L]
  RewriteRule ^(?:(?:uz|ru|en)/)?news/35488ec1-644a-4fd4-bf80-8fb16aa177b4(?:-[^/]*)?/?$ https://airi.uz/umumiy-malumot/news/35488ec1-644a-4fd4-bf80-8fb16aa177b4-protection/ [R=301,L]
